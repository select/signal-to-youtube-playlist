# Signal Configuration
SIGNAL_GROUP_NAME="Music"
SIGNAL_PATH=snap/signal-desktop/current/.config/Signal

# YouTube Configuration
YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The frozen, full legacy playlist (optional; defaults to the known Musik Gruppe
# 2025 playlist). Its video ids are cached via `pnpm cache:legacy`.
# LEGACY_PLAYLIST_ID=PLHh-DPsAXiAUVUVA9DpRtiYRrwgvqg8Fx
YOUTUBE_CREDENTIALS_PATH=./credentials.json
YOUTUBE_TOKEN_PATH=./token.json
